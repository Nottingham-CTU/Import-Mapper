      "name": "fn mappingselect",
      "commands": [
        {
          "command": "waitForElementPresent",
          "target": "css=table.table tbody tr",
          "value": "30000",
          "id": "8981d743-edb0-4107-a10b-5e5a7f84326b",
          "comment": "Arguments: row, field (each 1-indexed), value"
        },
        {
          "command": "runScript",
          "target": "$('#import-wrangler .table tbody tr').each(function(i){$(this).attr('data-testing',''+(i+1))})",
          "value": "",
          "id": "a086ab89-3529-411b-9d0f-1c921bf46786",
          "comment": ""
        },
        {
          "command": "waitForElementPresent",
          "target": "css=[data-testing=\"${row}\"]",
          "value": "30000",
          "id": "4d4a4277-d006-43ba-b6ce-2f0d4bc7a0e0"
        },
        {
          "command": "runScript",
          "target": "$('[data-testing=\"' + ${row} + '\"] select').eq(${field}-1)[0].value=${value}",
          "value": "",
          "id": "d6be3fb7-00b2-4a27-9e74-a7fcf4be972e"
